# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# Ключ Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
# Цепочка моделей через запятую (необязательно). По умолчанию — все бесплатные:
# gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.0-flash, gemini-2.0-flash-lite + новые flash, найденные автоматически
GEMINI_MODELS=

# Кто может пользоваться ботом и получает рассылку — Telegram ID через запятую (узнать: @userinfobot)
ALLOWED_USERS=413753314

GIRL_NAME=Настя
# Твоё имя (необязательно) — Gemini будет иногда это учитывать
SENDER_NAME=
# День рождения в формате ММ-ДД — в этот день будет особое поздравление
GIRL_BIRTHDAY=

TIMEZONE=Europe/Moscow
# Расписание по умолчанию — она может поменять его сама в боте (/schedule)
DEFAULT_TIMES=10:00,23:00
